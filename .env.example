# ==========================================
# Configurações do WhatsApp AI Chatbot
# ==========================================

# Ambiente (development / production)
ENVIRONMENT=development

# Provedor de IA ('gemini' ou 'openai')
AI_PROVIDER=gemini

# Se usar Google Gemini:
GEMINI_API_KEY=sua_chave_gemini_aqui
GEMINI_MODEL=gemini-1.5-flash

# Se usar OpenAI:
OPENAI_API_KEY=sua_chave_openai_aqui
OPENAI_MODEL=gpt-4o-mini

# Provedor do WhatsApp (Evolution API / Z-API)
WHATSAPP_PROVIDER=evolution
WHATSAPP_API_URL=http://localhost:8080
WHATSAPP_API_KEY=sua_apikey_da_evolution_api
WHATSAPP_INSTANCE_NAME=main_instance

# Configurações de Atendimento
MAX_HISTORY_MESSAGES=6
HUMAN_TAKEOVER_KEYWORD=#humano
